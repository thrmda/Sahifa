        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المسار ليس مجلدًا."
          }
        }
      }
    },
    "The token couldn't be saved to your Keychain, so it wasn't kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الرمز في سلسلة المفاتيح، فلم يُحتفظ به."
          }
        }
      }
    },
    "The token is kept in your Mac's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ الرمز في سلسلة مفاتيح الماك."
          }
        }
      }
    },
    "The token no longer has access. Reconnect to keep saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
