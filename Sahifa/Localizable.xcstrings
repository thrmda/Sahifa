    "Move Down": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحريك لأسفل"
          }
        }
      }
    },
    "owner/repository": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المالك/المستودع"
          }
        }
      }
    },
    "“%@” has unsaved changes that couldn't be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي «%@» على تغييرات تعذّر حفظها."
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld نقطة"
          }
        }
      }
    },
    "A document changed elsewhere while you were editing it, and is waiting for you to choose which version to keep.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر أحد المستندات في مكان آخر أثناء تحريرك له، وينتظر أن تختار النسخة التي تريد الاحتفاظ بها."
          }
        }
      }
    },
    "The server couldn't be reached.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم."
          }
        }
      }
    },
    "If you quit now, these changes are lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا خرجت الآن، ستُفقد هذه التغييرات."
          }
        }
      }
    },
    "View": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض"
          }
        }
      }
    },
    "This item can't be changed here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير هذا العنصر هنا."
          }
        }
      }
    },
    "A name can't be empty, start with a dot, or contain \"/\" or \":\".": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يكون الاسم فارغًا، أو أن يبدأ بنقطة، أو أن يحتوي على \"/\" أو \":\"."
          }
        }
      }
    },
    "\"%@\" is already taken. Choose a different name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم \"%@\" مستخدم بالفعل. اختر اسمًا آخر."
          }
        }
      }
    },
    "This document changed elsewhere while you were editing it. Resolve that first, then rename it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا المستند في مكان آخر أثناء تحريرك له. احسم ذلك أولًا، ثم أعد تسميته."
          }
        }
      }
    },
    "GitHub refused the change: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض GitHub التغيير: %@"
          }
        }
      }
    },
    "The server returned an error (%lld).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد الخادم خطأً (%lld)."
          }
        }
      }
    },
    "The document took too long to lay out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تنسيق المستند وقتًا طويلًا جدًا."
          }
        }
      }
    },
    "The page stopped rendering before the PDF was finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف عرض الصفحة قبل اكتمال ملف PDF."
          }
        }
      }
    },
    "Could not measure the document for pagination.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قياس المستند لتقسيمه إلى صفحات."
          }
        }
      }
    },
    "Could not serialize the PDF.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء ملف PDF."
          }
        }
      }
    },
    "Enter it as owner/repository, or paste its address - for example apple/swift-markdown. Public repositories can be read without signing in; connect an account in Settings to save changes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخله بالصيغة المالك/المستودع، أو الصق عنوانه - مثل apple/swift-markdown. يمكن قراءة المستودعات العامة دون تسجيل الدخول، واربط حسابًا من الإعدادات لحفظ التغييرات."
          }
        }
      }
    },
    "That isn't a repository name. Enter it as owner/repository, for example apple/swift-markdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس اسم مستودع. أدخله بالصيغة المالك/المستودع، مثل apple/swift-markdown."
          }
        }
      }
    },
    "Connected as %@ · expires %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل باسم %@ · تنتهي صلاحيته في %@"
          }
        }
      }
    },
    "Connected as %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل باسم %@"
          }
        }
      }
    },
    "%@ - %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ - %2$@"
          }
        }
      }
    },
    "%@ no longer has access. Reconnect to keep saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد %@ يملك صلاحية الوصول. أعد الاتصال لمتابعة الحفظ."
          }
        }
      }
    },
    "That didn't work": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام ذلك"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسنًا"
          }
        }
      }
    },
    "Choose a Markdown file from the sidebar, or open one in this tab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملف Markdown من الشريط الجانبي، أو افتح ملفًا في علامة التبويب هذه."
          }
        }
      }
    },
    "Read-only. Connect a GitHub account in Settings to save changes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للقراءة فقط. اربط حساب GitHub من الإعدادات لحفظ التغييرات."
          }
        }
      }
    },
    "%@×": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        }
      }
    },
    "%lld documents have unsaved changes that couldn't be saved.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا توجد مستندات فيها تغييرات تعذّر حفظها."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مستند واحد فيه تغييرات تعذّر حفظها."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مستندان فيهما تغييرات تعذّر حفظها."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مستندات فيها تغييرات تعذّر حفظها."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مستندًا فيها تغييرات تعذّر حفظها."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مستند فيها تغييرات تعذّر حفظها."
                }
              }
            }
          }
        }
      }
    }
  },
  "version": "1.0"
}
