    },
    "Shown as Arabic (Windows-1256), read-only. Convert it to UTF-8 to edit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معروض بترميز عربي (Windows-1256) للقراءة فقط. حوّله إلى UTF-8 لتتمكن من تحريره."
          }
        }
