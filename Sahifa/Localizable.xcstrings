{
  "sourceLanguage": "en",
  "strings": {
    "Access was refused. Check the account or token.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول. تحقق من الحساب أو الرمز."
          }
        }
      }
    },
    "Accounts": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحسابات"
          }
        }
